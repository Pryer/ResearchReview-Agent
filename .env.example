# ============================================================
# ResearchReview-Agent 环境变量模板
# ============================================================

# ---------- 应用基础配置 ----------
APP_NAME=ResearchReview-Agent
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
# 部署到共享环境时必须设置；前端请求需携带 X-API-Key。
APP_API_KEY=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
FRONTEND_API_BASE_URL=http://127.0.0.1:8000/api

# ---------- LLM 配置（OpenAI 兼容格式）----------
# 默认使用 DeepSeek，可切换为 OpenAI / Qwen / 本地 Ollama
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# DeepSeek V4 默认开启思考；综述长文生成建议关闭，避免 reasoning 占满输出预算。
LLM_THINKING_ENABLED=false
LLM_THINKING_EFFORT=low
LLM_THINKING_MAX_TOKENS=32768
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
LLM_CONTROL_PLANE_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=120
LLM_CONTROL_PLANE_TIMEOUT=120
LLM_FAILOVER_TOTAL_TIMEOUT=180

# 备用 LLM 提供商：主用失败（超时/连接错误/429/5xx）后自动切换，同样 120s。
# 留空则不启用备用。主备都失败后仍由各模块确定性兜底。
LLM_BACKUP_PROVIDER=
LLM_BACKUP_API_KEY=your-backup-api-key-here
LLM_BACKUP_BASE_URL=
LLM_BACKUP_MODEL=

# ---------- 本地存储与后台任务 ----------
# API 仅允许导入此目录内的 PDF，禁止传入任意服务器路径。
LIBRARY_IMPORT_DIR=./data/imports
RESEARCH_JOB_MAX_WORKERS=2
RESEARCH_JOB_MAX_PENDING=20

# 备选：OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# 备选：通义千问
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-xxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 备选：本地 Ollama
# LLM_PROVIDER=ollama
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5

# ---------- 论文数据源 API Key（可选，加额度）----------
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.1
CROSSREF_MAILTO=your-email@example.com

# ---------- CNKI（知网）Selenium 客户端 ----------
# chromedriver.exe 路径；留空则交给 Selenium Manager 自动下载（国内常失败，建议指定）
CNKI_CHROMEDRIVER_PATH=./chromedriver-win64/chromedriver.exe
# 是否无头模式（CNKI 对 headless 检测较严，默认 false 最稳）
CNKI_HEADLESS=false
# 进入知网首页后停留秒数，让页面充分加载
CNKI_HOME_WAIT_SECONDS=3.0
# 每轮最多进入多少篇 CNKI 详情页补全作者、摘要、关键词和 DOI
CNKI_DETAIL_ENRICHMENT_LIMIT=60
# 连续详情页失败达到该次数后停止详情增强，保留已经取得的结果页元数据
CNKI_MAX_CONSECUTIVE_DETAIL_FAILURES=2
CNKI_PAGE_LOAD_TIMEOUT_SECONDS=30

# ---------- 数据库 ----------
DATABASE_URL=sqlite:///./data/research_review.db

# ---------- 存储路径 ----------
VECTORSTORE_PATH=./data/vector_index
PDF_SAVE_DIR=./data/pdfs
PARSED_SAVE_DIR=./data/parsed
REVIEW_SAVE_DIR=./data/reviews

# ---------- Agent 默认参数 ----------
DEFAULT_MAX_PAPERS=30
DEFAULT_YEAR_LOOKBACK=3
SEARCH_YEAR_EXTENSION=1
MAX_YEAR_LOOKBACK=5
MAX_SEARCH_KEYWORDS=4
MAX_RESULTS_PER_KEYWORD=60
SEARCH_SOURCE_MAX_WORKERS=4
# 论文详情补全并发数；过高容易触发外部学术 API 限流。
DETAIL_FETCH_MAX_WORKERS=8
DEFAULT_SEARCH_SOURCES=arxiv,semantic_scholar,openalex,crossref,cnki
AGENT_REQUEST_TIMEOUT=60
FRONTEND_REQUEST_TIMEOUT=600
# 默认从摘要生成 Evidence Card；开启 PDF 流程后可保留全文页码。
ENABLE_PDF_PIPELINE=true
# 引用计划默认使用确定性主题均衡算法，避免额外的控制面 LLM 超时。
ENABLE_LLM_CITATION_PLANNING=false
# PDF 下载采用受控并发、失败重试和文件真实性校验。
PDF_DOWNLOAD_MAX_WORKERS=4
PDF_DOWNLOAD_RETRIES=3
PDF_DOWNLOAD_BACKOFF_SECONDS=0.8
PDF_DOWNLOAD_CONNECT_TIMEOUT=15
PDF_DOWNLOAD_MAX_MB=80
# 逐篇调用 LLM 抽卡成本较高，默认使用可解释规则基线。
ENABLE_LLM_CARD_EXTRACTION=false
# 对整批 Paper Card 调用一次 LLM，归纳互斥且可解释的综述分类。
ENABLE_LLM_CLUSTERING=true
# 生成后执行句子级 Claim-Evidence 验证。
ENABLE_CLAIM_VERIFICATION=true
# 路线验证后启用证据恢复闭环；LLM 诊断缺口，确定性控制器限制循环。
ENABLE_EVIDENCE_RECOVERY=true
EVIDENCE_RECOVERY_MAX_ROUNDS=2
EVIDENCE_RECOVERY_MAX_ROUTE_ATTEMPTS=2
EVIDENCE_RECOVERY_MAX_SCOPE_REVISIONS=1
EVIDENCE_RECOVERY_MIN_NEW_EVIDENCE=2
EVIDENCE_RECOVERY_MIN_COVERAGE_GAIN=0.05
EVIDENCE_RECOVERY_MIN_QUERY_NOVELTY=0.35
EVIDENCE_RECOVERY_SCOPE_GAP_RATIO=0.75
ROUTE_VALIDATOR_MIN_CORE_EVIDENCE=3
ROUTE_VALIDATOR_DROP_RATIO_GUARD=0.60
ROUTE_VALIDATOR_MIN_KEEP_RATE=0.40
# ---------- 全局证据门（Global Evidence Gate）----------
# 综述级证据充分性门禁：评估引用数量、年份窗口、路线均衡与同行评审占比，
# 只输出缺口与建议，不执行任何恢复动作（v1 冻结范围）。
ENABLE_GLOBAL_EVIDENCE_GATE=true
GLOBAL_GATE_MIN_RECENCY_RATIO=0.9
GLOBAL_GATE_ROUTE_BALANCE_MIN_RATIO=0.25
GLOBAL_GATE_PEER_REVIEW_RATIO=0.8
# Dynamic taxonomy LLM budget. Papers above the assignment limit are assigned
# deterministically to the induced themes, preventing unbounded LLM latency.
TAXONOMY_INDUCTION_LIMIT=40
TAXONOMY_LLM_ASSIGNMENT_LIMIT=45
TAXONOMY_INDUCTION_TIMEOUT=120
TAXONOMY_ASSIGNMENT_TIMEOUT=45
